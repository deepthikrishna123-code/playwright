{
  "name": "playwright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "headed": "npx playwright test --headed",
    "config": "npx playwright test --config=playwright.config1.js",
    "projects": "npx playwright test --config=playwright.config1.js --project=chromeProject",
    "debug": "npx playwright test --debug",
    "UImode": "npx playwright test --ui",
    "webtag": "npx playwright test --grep @web",
    "webortag": "npx playwright test --grep @web|@tag",
    "webandtag": "npx playwright test --grep '(?=.*@web)(?=.*@tag)'",
    "rmdir": "rmdir /s /q allure-results",
    "allure": "npx allure  generate allure-results --clean  -o allure-report && npx allure serve allure-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
